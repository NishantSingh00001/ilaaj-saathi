# Copy to .env for local development, or add these in your hosting dashboard.

# Turns on AI answers (Claude). Without it, Saathi uses built-in offline answers.
ANTHROPIC_API_KEY=
# Optional: override the model (default: claude-haiku-4-5-20251001)
LLM_MODEL=

# Turns on anonymous impact counters for /impact (free Upstash Redis database).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
